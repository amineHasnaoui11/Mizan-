# ---------------------------------------------------------------------------
# Fournisseur de modèles : "anthropic" (Claude) ou "esprit" (Token Factory)
# ---------------------------------------------------------------------------
MIZAN_PROVIDER=anthropic

# URL du backend FastAPI vue par l'UI Streamlit
MIZAN_API_URL=http://localhost:8000

# Plafond de tokens de sortie
MIZAN_MAX_TOKENS=8000

# --- Fournisseur Anthropic (Claude, vision-first) --------------------------
ANTHROPIC_API_KEY=sk-ant-...
MIZAN_MODEL=claude-opus-4-8
# Effort de raisonnement : low | medium | high | xhigh | max
MIZAN_EFFORT=high

# --- Fournisseur Esprit (Token Factory, réseau/VPN Esprit requis) ----------
# Active-le avec MIZAN_PROVIDER=esprit ci-dessus.
ESPRIT_API_KEY=sk-...
MIZAN_ESPRIT_BASE_URL=https://tokenfactory.esprit.tn/api
# LLaVA lit la photo (faible sur l'arabe manuscrit), Llama 3.1 70B note.
MIZAN_ESPRIT_VISION_MODEL=hosted_vllm/llava-1.5-7b-hf
MIZAN_ESPRIT_TEXT_MODEL=hosted_vllm/Llama-3.1-70B-Instruct
# Certificat TLS interne : laisser false pour ne pas vérifier le certificat.
MIZAN_ESPRIT_VERIFY_TLS=false

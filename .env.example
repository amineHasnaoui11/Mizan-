# Clé API Anthropic — obligatoire
ANTHROPIC_API_KEY=sk-ant-...

# Modèle vision utilisé pour lire + noter les copies (défaut : claude-opus-4-8)
MIZAN_MODEL=claude-opus-4-8

# Niveau d'effort de raisonnement : low | medium | high | xhigh | max (défaut : high)
MIZAN_EFFORT=high

# URL du backend FastAPI vue par l'UI Streamlit
MIZAN_API_URL=http://localhost:8000

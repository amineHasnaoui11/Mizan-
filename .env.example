# ---------------------------------------------------------------------------
# Fournisseur de modèles : "anthropic" (Claude) ou "esprit" (Token Factory)
# ---------------------------------------------------------------------------
MIZAN_PROVIDER=anthropic

# URL du backend FastAPI vue par l'UI Streamlit
MIZAN_API_URL=http://localhost:8000

# Plafond de tokens de sortie
MIZAN_MAX_TOKENS=8000

# --- Fournisseur Anthropic (Claude, vision-first) --------------------------
ANTHROPIC_API_KEY=sk-ant-...
MIZAN_MODEL=claude-opus-4-8
# Effort de raisonnement : low | medium | high | xhigh | max
MIZAN_EFFORT=high

# --- Fournisseur Esprit (Token Factory, réseau/VPN Esprit requis) ----------
# Active-le avec MIZAN_PROVIDER=esprit ci-dessus.
ESPRIT_API_KEY=sk-...
MIZAN_ESPRIT_BASE_URL=https://tokenfactory.esprit.tn/api
# LLaVA lit la photo (faible sur l'arabe manuscrit), Llama 3.1 70B note.
MIZAN_ESPRIT_VISION_MODEL=hosted_vllm/llava-1.5-7b-hf
MIZAN_ESPRIT_TEXT_MODEL=hosted_vllm/Llama-3.1-70B-Instruct
# Certificat TLS interne : laisser false pour ne pas vérifier le certificat.
MIZAN_ESPRIT_VERIFY_TLS=false

# --- Lecture de la copie (OCR) --------------------------------------------
# Comment lire la photo côté Esprit : llava | google | easyocr | paddle
#   google  = Google Cloud Vision (meilleur manuscrit, compte cloud requis)
#   easyocr = open-source/offline, s'installe bien sur Windows (pip install easyocr)
#   paddle  = open-source/offline (pip install paddleocr paddlepaddle)
MIZAN_OCR=easyocr
# Langues EasyOCR. L'arabe ne se combine qu'avec ar/fa/ur/ug/en (pas "fr").
# "en" lit le script latin, donc le français passe. Défaut : ar,en
MIZAN_EASYOCR_LANGS=ar,en
# Preprocessing OpenCV avant l'OCR (deskew, binarisation, CLAHE).
# Inutile avec Google Vision, utile avec PaddleOCR.
MIZAN_PREPROCESS=false
# Google Cloud Vision — deux modes d'authentification (choisis-en UN) :
#  A) Clé API simple (recommandé si ton orga bloque les clés JSON de compte
#     de service : erreur iam.disableServiceAccountKeyCreation). Juste une
#     chaîne, aucun fichier à gérer :
GOOGLE_API_KEY=
#  B) Clé JSON de compte de service (si les clés API ne conviennent pas) :
GOOGLE_APPLICATION_CREDENTIALS=C:\chemin\vers\cle-google.json
